# ==========================================
# CONFIGURAÇÕES GERAIS DO CLIENTE
# ==========================================
CLIENT_NAME=cliente-demo
DOMAIN_NAME=cliente-demo.com
TRAEFIK_ACME_EMAIL=admin@cliente-demo.com

# ==========================================
# PATH DO CHROMIUM PARA AUTOMATION & TESTES
# ==========================================
CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser

# ==========================================
# CREDENCIAIS DOS SERVIÇOS INFRAESTRUTURA
# (Geradas automaticamente pelo setup se vazias)
# ==========================================

# 1. MongoDB
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=
MONGO_PORT=27017

# 2. Redis
REDIS_PASSWORD=
REDIS_PORT=6379

# 3. Postvector (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=app_db
POSTGRES_PORT=5432

# 3.1. PostgreSQL Padrão (Sem modificações - Coexistindo com Postvector)
POSTGRES_STD_USER=postgres
POSTGRES_STD_PASSWORD=
POSTGRES_STD_DB=evoc_db
POSTGRES_STD_PORT=5433

# 4. RabbitMQ
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# 5. MinIO (S3 Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# 6. Jenkins (CI/CD)
JENKINS_PORT=8080
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=

# 7. n8n (Workflow Automation)
N8N_PORT=5678
N8N_ENCRYPTION_KEY=

# 8. Portainer
PORTAINER_PORT=9002

# 9. Evogo (Evolution API Go)
EVOGO_IMAGE=evolutionapi/evogo:latest
EVOGO_API_KEY=
EVOGO_PORT=8080

# 10. Evoccrm (Evolution CRM)
EVOCCRM_IMAGE=evolutionapi/evoccrm:latest
EVOCCRM_SECRET_KEY=
EVOCCRM_PORT=3000
